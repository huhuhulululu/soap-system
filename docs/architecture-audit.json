  "dataFlow": {
    "batchGeneration": [
      "HTTP POST /api/batch → multer (memory) → parseExcelBuffer [async]",
      "→ buildPatientsFromRows [sync]",
      "→ generateMixedBatch [sync, CPU INTENSIVE]",
      "  → per patient: normalizeGenerationContext → inferMedicalProfile",
      "  → IE/RE: exportSOAPAsText(generateSOAPNote(ctx))",
      "  → TX series: exportTXSeriesAsText(ctx, options)",
      "    → tx-sequence-engine: for loop × txCount, each iteration ~30 rng() calls",
      "    → per visit: assemble S/O/A/P sections via rule engine + weight system",
      "  → optional: patchSOAPText (objective-patch)",
      "→ splitSOAPText [sync]",
      "→ saveBatch [sync, fs.writeFileSync]",
      "→ HTTP response"
    ],
    "frontendGeneration": [
      "User clicks Generate → useSOAPGeneration.generate()",
      "→ normalizeGenerationContext [sync, main thread]",
      "→ generateTXSequenceStates [sync, main thread, CPU INTENSIVE]",
      "→ exportSOAPAsText × N visits [sync, main thread]",
      "→ optional: patchSOAPText [sync, main thread]",
      "→ validateGeneratedSequence [sync, main thread]",
      "→ reactive state update → DOM render"
    ],
    "automation": [
      "HTTP POST /api/automate/:batchId",
      "→ verify: batch confirmed + cookies exist + not running",
      "→ decryptCookiesToTempFile [sync, fs.writeFileSync]",
      "→ spawn child process: npx tsx mdland-automation.ts",
      "→ child stdout/stderr → currentJob.logs (max 500 lines)",
      "→ child close → cleanupTempCookies + update currentJob status",
      "→ HTTP response (immediate, job runs in background)"
    ]
  }
